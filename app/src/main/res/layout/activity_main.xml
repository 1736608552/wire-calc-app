<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="阻值线径速算器"
            app:subtitle="R₁ × r₁² = R₂ × r₂²"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="#E0E0E0" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部快捷操作栏 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="清空所有"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- 输入卡片：状态1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="参数组 1 (原始状态)"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="12dp" />

                    <!-- R1 输入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutR1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="阻值 1 (R₁)"
                        app:suffixText="Ω"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etR1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- r1 输入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutR1Diameter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="直径 1 (r₁)"
                        app:suffixText="mm"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etR1Diameter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 输入卡片：状态2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="参数组 2 (目标状态)"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="12dp" />

                    <!-- R2 输入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutR2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="阻值 2 (R₂)"
                        app:suffixText="Ω"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etR2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- r2 输入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutR2Diameter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="直径 2 (r₂)"
                        app:suffixText="mm"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etR2Diameter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 动态结果展示卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="3dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/result_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvResultTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="计算结果"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/result_text" />

                    <TextView
                        android:id="@+id/tvResultValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="请在上方输入任意 3 个数"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/result_text" />

                    <TextView
                        android:id="@+id/tvResultFormula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="留空要计算的项，系统将自动算出"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#388E3C" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:text="复制计算结果"
                        app:icon="@android:drawable/ic_menu_agenda"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 底部原理与公式卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="1dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📐 物理公式与换算原理"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_sub"
                        android:text="• 原理：导线电阻 R = ρ·L/S，由于截面积 S ∝ r²，在材质与长度不变时，电阻值与直径的平方成反比。\n• 关系等式：R₁ × r₁² = R₂ × r₂²\n• 求 r₂ (原图红圈)：r₂ = √(R₁ × r₁² / R₂)\n• 求 R₂：R₂ = (R₁ × r₁²) / r₂²\n• 求 r₁：r₁ = √(R₂ × r₂² / R₁)\n• 求 R₁：R₁ = (R₂ × r₂²) / r₁²" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
